{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "vue", "import", "vitest"],
  "env": {
    "node": true,
    "browser": true
  },
  "ignorePatterns": ["**/dist/**", "**/.nuxt/**", "**/.output/**", "data/**"],
  "rules": {
    "curly": "error",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-unused-vars": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error"
  }
}
